{
  "name": "turborepo-basic-shared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.8"
  },
  "engines": {
    "node": "22.23.3"
  },
  "packageManager": "pnpm@8.15.9",
  "dependencies": {
    "uuid": "^8.3.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-beautiful-dnd@13.1.1": "patches/react-beautiful-dnd@13.1.1.patch"
    }
  }
}
